# Builds default to demo when omitted. Unknown profiles are errors.
PUBLIC_DEPLOYMENT_PROFILE=demo
# Set to this deployment's own origin. Production requires a public HTTPS domain.
# PUBLIC_SITE_ORIGIN=https://your-business.kz
# Vercel provides VERCEL_ENV and VERCEL_URL; do not set them manually.
# Vercel previews always use demo policy, including with a production profile.
# Set ENABLE_EXPERIMENTAL_COREPACK=1 in Vercel to use pnpm@12.18.0.
