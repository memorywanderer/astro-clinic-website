---
import type { HTMLAttributes } from 'astro/types';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Media, { type MediaSource } from '../ui/Media.astro';

interface Props extends Omit<HTMLAttributes<'section'>, 'title'> {
  layout?: 'centered' | 'split' | 'fullBleed';
  title?: string;
  description?: string;
  eyebrow?: string;
  level?: 1 | 2 | 3 | 4 | 5 | 6;
  media?: MediaSource;
  mediaPriority?: boolean;
}
const {
  layout = 'centered',
  title,
  description,
  eyebrow,
  level = 1,
  media,
  mediaPriority = false,
  class: className,
  ...rest
}: Props = Astro.props;
const hasMedia = !!media || Astro.slots.has('media');
---

<section {...rest} class:list={['hero', className]} data-layout={layout}>
  <Container
    class:list={[
      'hero-content grid items-center gap-panel',
      { 'lg:grid-cols-2': layout === 'split' && hasMedia },
    ]}
  >
    <div
      class:list={[
        'grid min-w-0 gap-6',
        { 'justify-items-center': layout === 'centered' },
      ]}
    >
      <SectionHeading
        {title}
        {description}
        {eyebrow}
        {level}
        scale="display"
        align={layout === 'centered' ? 'center' : 'start'}
      >
        <slot name="title" slot="title">
          {title}
        </slot>
        <slot name="eyebrow" slot="eyebrow">
          {eyebrow}
        </slot>
        <slot name="description" slot="description">
          {description && <p>{description}</p>}
        </slot>
      </SectionHeading>
      {Astro.slots.has('actions') && (
        <div class="flex min-w-0 flex-wrap gap-4">
          <slot name="actions" />
        </div>
      )}
    </div>
    {hasMedia && (
      <div class="hero-media min-w-0">
        <slot name="media">
          {media && (
            <Media
              {media}
              priority={mediaPriority}
              sizes={
                layout === 'split' ? '(min-width: 64rem) 50vw, 100vw' : '100vw'
              }
            />
          )}
        </slot>
      </div>
    )}
  </Container>
</section>

<style>
  @layer components {
    .hero {
      padding-block: var(--section-space);
    }
    .hero[data-layout='fullBleed'] {
      padding: 0;
    }
    [data-layout='fullBleed'] .hero-content {
      max-width: none;
      padding: 0;
      gap: 0;
    }
    [data-layout='fullBleed'] .hero-content > :first-child {
      padding: var(--section-space) var(--page-gutter);
    }
    [data-layout='fullBleed'] .hero-media {
      width: 100%;
    }
  }
</style>
