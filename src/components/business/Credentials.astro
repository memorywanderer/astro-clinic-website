---
import type { HTMLAttributes } from 'astro/types';
import type { Credential } from '@/content/business';
import { isCurrent } from '@/lib/business/formatting';
import Media from '@/components/ui/Media.astro';
import BusinessActionLink from './BusinessActionLink.astro';
interface Props extends HTMLAttributes<'ul'> {
  items: readonly Credential[];
}
const { items, class: className, ...rest } = Astro.props;
const visible = items.filter(
  (item) =>
    item.verified && item.name.trim() && item.issuer.trim() && isCurrent(item),
);
---

{visible.length > 0 && (
  <ul {...rest} class:list={['grid gap-4 md:grid-cols-2', className]}>
    {visible.map((item) => (
      <li class="bg-card text-card-foreground border-border grid min-w-0 gap-2 rounded-md border p-panel">
        {item.media && <Media media={item.media} />}
        <p class="font-bold">{item.name}</p>
        <p>{item.issuer}</p>
        {item.reference && <p>{item.reference}</p>}
        {item.dateLabel && <p>{item.dateLabel}</p>}
        {item.expiryLabel && <p>{item.expiryLabel}</p>}
        <BusinessActionLink action={item.link} presentation="text" />
      </li>
    ))}
  </ul>
)}
