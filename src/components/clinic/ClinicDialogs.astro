---
import type { ClinicHomeContent } from '@/content/clinic-home';
interface Props {
  content: ClinicHomeContent;
}
const { content: c } = Astro.props;
---

<dialog
  id="action-dialog"
  aria-labelledby="action-title"
  aria-modal="true"
  class="clinic-dialog"
>
  <button type="button" data-close-dialog class="dialog-close">
    {c.ui.close}
  </button>
  <h2 id="action-title">{c.ui.demoTitle}</h2>
  <p>{c.ui.demoText}</p>
  <p data-action-preview></p>
</dialog>
{[
  { id: 'privacy-dialog', title: c.final.privacy, text: c.final.privacyText },
].map((item) => (
  <dialog
    id={item.id}
    aria-labelledby={`${item.id}-title`}
    aria-modal="true"
    class="clinic-dialog"
  >
    <button type="button" data-close-dialog class="dialog-close">
      {c.ui.close}
    </button>
    <h2 id={`${item.id}-title`}>{item.title}</h2>
    <p>{item.text}</p>
  </dialog>
))}
