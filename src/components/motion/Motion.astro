---
// Include once in a page/layout that opts into observer-triggered motion.
---

<script>
  import { setupReveals } from '@/lib/motion/reveal';
  let cleanup = setupReveals();
  window.addEventListener('pagehide', () => cleanup());
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) cleanup = setupReveals();
  });
</script>
