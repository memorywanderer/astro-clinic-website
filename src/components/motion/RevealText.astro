---
import type { HTMLAttributes } from 'astro/types';
import { splitWords } from '@/lib/motion/text';
interface Props extends HTMLAttributes<'span'> {
  text: string;
  mode?: 'words' | 'mask';
}
const { text, mode = 'words', class: className, ...rest } = Astro.props;
let index = 0;
---

<span {...rest} class:list={['motion-text', className]} data-motion={mode}>
  <span class="sr-only">{text}</span>
  <span aria-hidden="true" class:list={{ 'motion-mask': mode === 'mask' }}>
    {mode === 'words' ? (
      splitWords(text).map((part) =>
        /^\s+$/u.test(part) ? (
          part
        ) : (
          <span class="motion-word" style={`--motion-index: ${index++}`}>
            {part}
          </span>
        ),
      )
    ) : (
      <span class="motion-mask-content">{text}</span>
    )}
  </span>
</span>
