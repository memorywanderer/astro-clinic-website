---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  width?: 'content' | 'reading' | 'wide' | 'full';
}
const { width = 'content', class: className, ...rest } = Astro.props;
---

<div {...rest} class:list={['container-frame', className]} data-width={width}>
  <slot />
</div>

<style>
  @layer components {
    .container-frame {
      width: 100%;
      margin-inline: auto;
      padding-inline: var(--page-gutter);
      max-width: calc(var(--content-width) + 2 * var(--page-gutter));
    }
    [data-width='reading'] {
      max-width: calc(var(--reading-width) + 2 * var(--page-gutter));
    }
    [data-width='wide'] {
      max-width: calc(var(--wide-width) + 2 * var(--page-gutter));
    }
    [data-width='full'] {
      max-width: none;
    }
  }
</style>
