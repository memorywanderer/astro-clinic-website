---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';

export interface MediaSource {
  src: ImageMetadata | string;
  alt: string;
  width: number;
  height: number;
}
interface Props extends Omit<
  HTMLAttributes<'img'>,
  'src' | 'alt' | 'width' | 'height'
> {
  media: MediaSource;
  priority?: boolean;
  /** Optional encoding choice for a measured critical-image budget. */
  quality?: number;
}
const { media, priority = false, class: className, ...rest } = Astro.props;
const imageProps = {
  ...rest,
  alt: media.alt,
  width: media.width,
  height: media.height,
  class: `h-auto w-full ${className ?? ''}`,
  widths: [320, 640, 768, 1024, media.width].filter(
    (width, index, values) =>
      width <= media.width && values.indexOf(width) === index,
  ),
  sizes: rest.sizes ?? '(min-width: 64rem) 50vw, 100vw',
  loading: priority ? ('eager' as const) : ('lazy' as const),
  fetchpriority: priority ? ('high' as const) : ('auto' as const),
  decoding: 'async' as const,
};
---

{typeof media.src === 'string' ? (
  <Image {...imageProps} src={media.src} />
) : (
  <Image {...imageProps} src={media.src} />
)}
