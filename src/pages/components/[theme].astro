---
import ComponentShowcase from '@/components/ComponentShowcase.astro';
import { themes, type Theme } from '@/config/site';

export function getStaticPaths() {
  // No showcase routes are generated by production builds.
  return import.meta.env.DEV
    ? themes.map((theme) => ({ params: { theme }, props: { theme } }))
    : [];
}
interface Props {
  theme: Theme;
}
---

<ComponentShowcase theme={Astro.props.theme} />
