---
import DesignSystemPreview from '@/components/DesignSystemPreview.astro';
import { themes, type Theme } from '@/config/site';

export function getStaticPaths() {
  return import.meta.env.DEV
    ? themes.map((theme) => ({ params: { theme }, props: { theme } }))
    : [];
}
interface Props {
  theme: Theme;
}
---

<DesignSystemPreview theme={Astro.props.theme} />
